# --- 2. Scalability & Complexity Comparison (1,000 vs 100,000 contacts) ---
print("\n=== Complexity & Operations Comparison (O(n) Dict vs O(n^2) Pairwise) ===")
for size in (1000, 100000):
    dataset = generate_synthetic_contacts(size)
    merged_big, dict_ops = merge_contacts([dataset])
    if size <= 1000:
        pair_ops = pairwise_duplicate_count(dataset)
    else:
        # Formula n*(n-1)//2 avoids waiting on 5 billion loop iterations in browser sandbox
        pair_ops = (size * (size - 1)) // 2
    print(
        "n =", size,
        "| Unique Merged =", len(merged_big),
        "| Dict O(n) Ops =", dict_ops,
        "| Pairwise O(n^2) Comparisons =", pair_ops
    )
